# === NapCat OneBot v11 (正向 WebSocket / forward WS) ===
# NapCat 作为 WS 服务端，本插件作为客户端连入。
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# === Bot 身份 ===
# 本机器人的 QQ 号，用于 @提及检测和自身消息过滤。
BOT_QQ=

# === 触发 ===
# 群聊中是否仅在被 @ 时响应（true/false）。命令（/stop 等）不受此限制。
NAPCAT_REQUIRE_MENTION=true

# === 访问控制（由 Hermes gateway 统一处理）===
# 允许与机器人对话的 QQ 号，逗号分隔。
NAPCAT_ALLOWED_USERS=
# 是否允许所有人对话（true/false，仅调试用）。
NAPCAT_ALLOW_ALL_USERS=false

# === cron / 通知投递目标 ===
# 例如 group:12345 或 user:67890
NAPCAT_HOME_CHANNEL=

# 说明：以上变量由 Hermes 在加载本插件时读取。部署时把它们写入 Hermes 的
# 环境（如 ~/.hermes/.env 或 systemd 环境），而不是放在本仓库目录下。
